#!/usr/bin/env bash
# Narrow root helper: reads a Cloudflare token from stdin, never arguments/logs.
set -euo pipefail

read -r CLOUDFLARE_DNS_API_TOKEN
if [[ ${#CLOUDFLARE_DNS_API_TOKEN} -lt 20 ]]; then
  exit 64
fi

credentials=$(mktemp /etc/letsencrypt/.cloudflare.XXXXXX)
cleanup() {
  shred -u "$credentials" 2>/dev/null || rm -f "$credentials"
}
trap cleanup EXIT
chmod 600 "$credentials"
printf 'dns_cloudflare_api_token = %s\n' "$CLOUDFLARE_DNS_API_TOKEN" > "$credentials"
unset CLOUDFLARE_DNS_API_TOKEN

certbot certonly --non-interactive --agree-tos --keep-until-expiring \
  --dns-cloudflare --dns-cloudflare-credentials "$credentials" \
  --dns-cloudflare-propagation-seconds 60 \
  --cert-name sellerbottel-v3-wildcard \
  -d idsestock.my.id -d '*.idsestock.my.id' \
  -d idseconnect.my.id -d '*.idseconnect.my.id'

install -d -m 755 /etc/nginx/conf.d
cat > /etc/nginx/conf.d/sellerbottel-v3-wildcards.conf <<'NGINX'
server {
    server_name *.idsestock.my.id *.idseconnect.my.id;
    root /opt/sellerbottel-v3/current/frontend/build;
    index index.html;

    location /api/ {
        proxy_pass http://127.0.0.1:8001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / { try_files $uri $uri/ /index.html; }

    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/sellerbottel-v3-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sellerbottel-v3-wildcard/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}
NGINX

nginx -t
systemctl reload nginx
