[Unit]
Description=SellerBottel V2 development backend (Docker Compose managed by systemd)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/sellerbottel-v2/repo
ExecStartPre=/usr/bin/docker compose -f /opt/sellerbottel-v2/repo/compose.yaml up -d --build backend-dev
ExecStart=/usr/bin/docker compose -f /opt/sellerbottel-v2/repo/compose.yaml up -d backend-dev
ExecStop=/usr/bin/docker compose -f /opt/sellerbottel-v2/repo/compose.yaml stop backend-dev
RemainAfterExit=yes
TimeoutStartSec=15min
TimeoutStopSec=90s

[Install]
WantedBy=multi-user.target
