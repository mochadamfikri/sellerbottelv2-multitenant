	@private path /api/internal/* /docs* /redoc* /openapi.json
	handle @private {
		respond 404
	}
	handle /api/* {
		reverse_proxy 127.0.0.1:8010
	}
	handle {
		reverse_proxy 127.0.0.1:3010
	}
}
