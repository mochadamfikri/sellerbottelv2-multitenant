pay.idsepos.my.id {
	@health {
		path /health
		method GET
	}
	handle @health {
		reverse_proxy 127.0.0.1:8007
	}
	@webhook {
		path /api/payments/webhooks/kasera
		method POST
	}
	handle @webhook {
		request_body {
			max_size 64KB
		}
